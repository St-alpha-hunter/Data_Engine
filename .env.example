POSTGRES_PASSWORD=change_me
# SEC 要求请求头里带联系方式：名字 + 邮箱
SEC_USER_AGENT=YourName your@email.com
# Airflow：元数据库密码；FERNET_KEY 用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me
# Superset：SECRET_KEY 用 python -c "import secrets; print(secrets.token_urlsafe(42))" 生成；RO = 看板用的只读账号 superset_ro
SUPERSET_SECRET_KEY=change_me
SUPERSET_DB_PASSWORD=change_me
SUPERSET_ADMIN_PASSWORD=change_me
SUPERSET_RO_PASSWORD=change_me
